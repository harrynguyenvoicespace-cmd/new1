{
  "name": "gestalt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:windows": "opennextjs-cloudflare build && node tools/fix-opennext-turbopack-windows.mjs",
    "build:next": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "wrangler dev",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "next lint",
    "tripo:dev": "wrangler dev --config cloudflare/tripo-api/wrangler.jsonc --port 8787",
    "tripo:deploy": "wrangler deploy --config cloudflare/tripo-api/wrangler.jsonc",
    "tripo:dry-run": "wrangler deploy --dry-run --config cloudflare/tripo-api/wrangler.jsonc",
    "tripo:secret": "wrangler secret put TRIPO_API_KEY --config cloudflare/tripo-api/wrangler.jsonc"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.27",
    "@ai-sdk/react": "^2.0.37",
    "@ai-sdk/xai": "^2.0.16",
    "@base-ui-components/react": "^1.0.0-beta.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/jszip": "^3.4.0",
    "@types/three": "^0.183.1",
    "@xyflow/react": "^12.8.4",
    "ai": "^5.0.37",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.539.0",
    "mediabunny": "^1.12.1",
    "motion": "^12.23.12",
    "nanoid": "^5.1.5",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-scan": "^0.4.3",
    "tailwind-merge": "^3.3.1",
    "three": "^0.183.1",
    "three-mesh-bvh": "^0.9.8",
    "three-stdlib": "^2.36.1",
    "zod": "^4.1.5",
    "zundo": "^2.3.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.105.0"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
